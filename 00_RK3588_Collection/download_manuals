#!/usr/bin/env bash
set -euo pipefail
COLLECTION_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ZIP_FILE="$COLLECTION_DIR/drive_download.zip"
DRIVE_SOURCE=${1:-${MANUALS_DRIVE_URL:-}}

if [[ ${1:-} == --help ]]; then
    printf 'Usage: %s [GOOGLE_DRIVE_URL_OR_ID | --local]\n' "$0"
    printf 'MANUALS_DRIVE_URL ကိုလည်း သတ်မှတ်နိုင်ပါတယ်။ --local က ရှိပြီးသား drive_download.zip ကို ဖြည်ပါတယ်။\n'
    exit 0
fi
if [[ $# -gt 1 ]]; then
    echo "Expected one Google Drive URL/file ID or --local." >&2
    exit 2
fi
if [[ -z $DRIVE_SOURCE ]]; then
    read -r -p 'Google Drive ZIP link သို့မဟုတ် file ID: ' DRIVE_SOURCE
fi
[[ -n $DRIVE_SOURCE ]] || { echo 'Google Drive link လိုပါတယ်။' >&2; exit 1; }
command -v python3 >/dev/null || { echo 'python3 လိုပါတယ်။' >&2; exit 1; }

TEMP_DIR=$(mktemp -d "$COLLECTION_DIR/.manuals-download.XXXXXX")
trap 'rm -rf -- "$TEMP_DIR"' EXIT
if [[ $DRIVE_SOURCE == --local ]]; then
    [[ -f $ZIP_FILE ]] || { echo "ZIP မရှိပါ: $ZIP_FILE" >&2; exit 1; }
    ARCHIVE=$ZIP_FILE
else
    command -v gdown >/dev/null || {
        echo 'gdown လိုပါတယ်။ pipx install gdown ဖြင့် တစ်ကြိမ် install လုပ်ပါ။' >&2
        exit 1
    }
    ARCHIVE="$TEMP_DIR/drive_download.zip"
    gdown "$DRIVE_SOURCE" -O "$ARCHIVE"
fi

# Validate the entire ZIP before writing; preserve existing manuals.
python3 - "$ARCHIVE" "$COLLECTION_DIR" <<'PY'
import pathlib
import shutil
import stat
import sys
import zipfile

archive, destination = map(pathlib.Path, sys.argv[1:])
allowed = {
    '01_Chip_Datasheets', '02_Vendor_Boards', '03_Compute_Modules',
    '04_Breakout_Carrier_Boards', '05_SDK_and_BSP_Docs',
    '06_Web_Archive_HTML', '07_Index', '08_Non_RK3588_Reference',
}
try:
    with zipfile.ZipFile(archive) as z:
        entries = z.infolist()
        if not entries:
            raise ValueError('ZIP is empty')
        for entry in entries:
            path = pathlib.PurePosixPath(entry.filename)
            if (path.is_absolute() or '..' in path.parts or not path.parts
                    or path.parts[0] not in allowed or '\\' in entry.filename
                    or (len(path.parts) == 1 and not entry.is_dir())
                    or stat.S_ISLNK(entry.external_attr >> 16)):
                raise ValueError(f'Unsupported ZIP path: {entry.filename}')
            target = destination.joinpath(*path.parts)
            for part in (target, *target.parents):
                if part == destination:
                    break
                if part != target and part.exists() and not part.is_dir():
                    raise ValueError(f'Destination parent is not a directory: {part}')
                if part.is_symlink():
                    raise ValueError(f'Destination symlink is not allowed: {part}')
            if target.exists() and target.is_dir() != entry.is_dir():
                raise ValueError(f'File/directory conflict: {target}')
        bad = z.testzip()
        if bad:
            raise ValueError(f'Corrupt ZIP entry: {bad}')
        written = skipped = 0
        for entry in entries:
            target = destination / entry.filename
            if entry.is_dir():
                target.mkdir(parents=True, exist_ok=True)
            elif target.exists():
                skipped += 1
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with z.open(entry) as source, target.open('xb') as output:
                    shutil.copyfileobj(source, output)
                written += 1
        print(f'Extracted: {written}; existing files kept: {skipped}')
except (OSError, ValueError, zipfile.BadZipFile, RuntimeError) as exc:
    raise SystemExit(f'Manuals ZIP error: {exc}')
PY
if [[ $DRIVE_SOURCE != --local ]]; then
    mv -- "$ARCHIVE" "$ZIP_FILE"
fi
printf 'Manuals အသင့်ဖြစ်ပါပြီ: %s\n' "$COLLECTION_DIR"
