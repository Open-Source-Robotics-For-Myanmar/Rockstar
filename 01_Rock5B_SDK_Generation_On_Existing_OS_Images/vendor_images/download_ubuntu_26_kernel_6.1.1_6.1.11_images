#!/usr/bin/env bash
set -euo pipefail
IMAGES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DRIVE_URLS=(
    'https://drive.google.com/file/d/1toe0_Xol2inKQ7Z8DxPg_5BjAr6OoAUQ/view?usp=sharing'
    'https://drive.google.com/file/d/1d-fiOTmMtGGSpfvCZQWcKRmAtfQQuSZO/view?usp=sharing'
)
IMAGE_NAMES=(
    'Armbian_26.8.3_Rock-5b_resolute_vendor_6.1.115_minimal.img.xz'
    'Armbian_26.8.3_Rock-5b_trixie_vendor_6.1.115_minimal.img.xz'
)

if [[ ${1:-} == --help ]]; then
    printf 'Usage: %s\nGoogle Drive မှ image နှစ်ခုကို vendor_images/ ထဲ သိမ်းပါတယ်။ Input မလိုပါ။\n' "$0"
    exit 0
fi
[[ $# -eq 0 ]] || { echo 'ဒီ script မှာ arguments မလိုပါ။' >&2; exit 2; }
command -v xz >/dev/null || { echo 'xz လိုပါတယ်။ sudo apt install xz-utils' >&2; exit 1; }
TEMP_DIR=$(mktemp -d "$IMAGES_DIR/.images-download.XXXXXX")
trap 'rm -rf -- "$TEMP_DIR"' EXIT

for index in "${!DRIVE_URLS[@]}"; do
    name=${IMAGE_NAMES[$index]}
    destination="$IMAGES_DIR/$name"
    if [[ -e $destination || -L $destination ]]; then
        [[ -f $destination && ! -L $destination ]] || { echo "Invalid destination: $destination" >&2; exit 1; }
        xz -t -- "$destination"
        printf 'ရှိပြီးသား image ကို ထားခဲ့ပါတယ်: %s\n' "$name"
        continue
    fi
    command -v gdown >/dev/null || {
        echo 'gdown လိုပါတယ်။ pipx install gdown ဖြင့် တစ်ကြိမ် install လုပ်ပါ။' >&2
        exit 1
    }
    gdown "${DRIVE_URLS[$index]}" -O "$TEMP_DIR/$name"
    xz -t -- "$TEMP_DIR/$name"
    # Publish only a complete XZ file; do not overwrite a concurrent download.
    ln -- "$TEMP_DIR/$name" "$destination"
    printf 'Download ပြီးပါပြီ: %s\n' "$name"
done
printf 'Images အသင့်ဖြစ်ပါပြီ: %s\n' "$IMAGES_DIR"
